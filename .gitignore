# --- dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- build output -----------------------------------------------------------
.next/
out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
# `next-env.d.ts` is generated by Next.js but committed, so that a fresh clone
# can run `npm run typecheck` before the first build.

# --- environment ------------------------------------------------------------
.env
.env.*
!.env.example

# --- test / tooling caches --------------------------------------------------
# Anchored to the repository root. An unanchored `coverage/` would also match
# `src/app/coverage/`, which is a real route and not a coverage report.
/coverage/
.nyc_output/
.vitest/
.playwright-cli/
.eslintcache

# --- editors and operating systems -----------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- logs -------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# --- local database used by the migration validator -------------------------
.pgpluck/
pgtest/
